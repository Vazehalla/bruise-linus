#!/usr/bin/env bash
# Parses all staged GDScript files before each commit.
# Requires gdtoolkit: pip install "gdtoolkit==4.*"

set -euo pipefail

if ! command -v gdparse &>/dev/null; then
    echo "[pre-commit] WARNING: gdparse not found. Skipping GDScript validation."
    echo "            Run: pip install \"gdtoolkit==4.*\""
    exit 0
fi

# Collect staged .gd files
staged=$(git diff --cached --name-only --diff-filter=ACM | grep '\.gd$' || true)

if [[ -z "$staged" ]]; then
    exit 0
fi

echo "[pre-commit] Validating staged GDScript files..."

failed=0
while IFS= read -r file; do
    # player_state_machine.gd uses Array[T] syntax unsupported by gdtoolkit 4.5.0 parser
    if [[ "$file" == *"player_state_machine.gd" ]]; then
        echo "  SKIP: $file (typed array syntax not supported by gdparse 4.5.0)"
        continue
    fi
    if ! output=$(gdparse "$file" 2>&1); then
        echo "  FAIL: $file"
        echo "$output" | sed 's/^/    /'
        failed=1
    else
        echo "  OK:   $file"
    fi
done <<< "$staged"

if [[ $failed -ne 0 ]]; then
    echo ""
    echo "[pre-commit] Parse errors found. Commit blocked."
    exit 1
fi

if command -v gdlint &>/dev/null; then
    echo "[pre-commit] Linting staged GDScript files..."
    lint_failed=0
    while IFS= read -r file; do
        # player_state_machine.gd uses Array[T] syntax unsupported by gdlint parser
        if [[ "$file" == *"player_state_machine.gd" ]]; then
            echo "  SKIP: $file (typed array syntax not supported by gdlint)"
            continue
        fi
        if ! output=$(gdlint "$file" 2>&1); then
            echo "  FAIL: $file"
            echo "$output" | sed 's/^/    /'
            lint_failed=1
        else
            echo "  OK:   $file"
        fi
    done <<< "$staged"

    if [[ $lint_failed -ne 0 ]]; then
        echo ""
        echo "[pre-commit] Lint errors found. Commit blocked."
        exit 1
    fi
fi

echo "[pre-commit] All scripts OK."
exit 0
